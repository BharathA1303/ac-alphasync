# ============================================================================
#  AlphaSync Real — Environment (.env.example)
#  Copy to .env on the server and fill in real values. NEVER commit .env.
#  Every secret is injected at runtime — nothing hardcoded in compose/Dockerfiles.
# ============================================================================

# ── Application ──
APP_NAME=AlphaSync-Real
APP_VERSION=2.0.0
DEBUG=false

# ── PostgreSQL (internal service "postgres" — never exposed) ──
# These build DATABASE_URL inside docker-compose.yml.
POSTGRES_DB=alphasync_real
POSTGRES_USER=alphasync_real
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Redis (internal service "redis") ──  REDIS_URL set by compose

# ── JWT / Security ──
JWT_SECRET_KEY=CHANGE_ME_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Broker credential encryption (at rest) ──
BROKER_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ── CORS (production domain) ──
CORS_ORIGINS=["https://demo.alphasync.app"]
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1):\d+

# ── Firebase Auth (backend service account) ──
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# ── Firebase (frontend / Vite — baked in at build time) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

ZEBU_API_SECRET=
ZEBU_VENDOR_CODE=
ZEBU_WS_URL=wss://go.mynt.in/NorenWSTP/
ZEBU_API_URL=https://go.mynt.in/NorenWClientTP
ZEBU_REDIRECT_URI=https://demo.alphasync.app/broker/callback
ZEBU_OAUTH_CLIENT_ID=

# ── Alice Blue broker (optional) ──
ALICE_BLUE_REDIRECT_URI=https://demo.alphasync.app/broker/callback

# ── Admin panel ──
# Root admin (full owner): unrestricted access, can create/manage other admins.
ROOT_ADMIN_EMAIL=meganath1025@gmail.com
ADMIN_EMAIL_ALLOWLIST=["meganath1025@gmail.com"]

# ── Twilio SMS OTP (optional; blank = email-only) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email / SMTP (Gmail app password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Grok / xAI (optional) ──
GROK_API_KEY=
XAI_API_KEY=

# ── Trading ──
DEFAULT_VIRTUAL_CAPITAL=1000000.0
SIMULATION_MODE=true
STRICT_ZEBU_MARKET_DATA=false
